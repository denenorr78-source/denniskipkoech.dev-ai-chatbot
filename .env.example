# App
APP_ENV=development
BOT_NAME="Denniskipkoech.dev AI Chatbot"
LEAD_NOTIFY_EMAIL=denenorr78@gmail.com
DATABASE_PATH=./data/leads.sqlite3
# Optional locally; required on Vercel/production. Use a pooled PostgreSQL URL.
DATABASE_URL=

# Meta (Instagram Professional + Facebook Messenger, typically Page-linked setup)
META_VERIFY_TOKEN=replace-with-random-webhook-token
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v25.0

# WhatsApp Business Platform / Cloud API
WHATSAPP_VERIFY_TOKEN=replace-with-random-webhook-token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# TikTok Business Messaging API
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_BUSINESS_ID=
TIKTOK_WEBHOOK_MAX_SKEW_SECONDS=300

# SMTP lead notifications. Use an app password or provider credential, never your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false
